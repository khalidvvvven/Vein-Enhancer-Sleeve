{
  "name": "warmup-vein-enhancer-sleeve",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Single-page product website for the WARMUP Vein Enhancer Sleeve.",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/build-images.mjs",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --host",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
